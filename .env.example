# Local development (uv run ...). docker compose builds its own URLs from POSTGRES_PASSWORD / READER_PASSWORD.
DATABASE_URL=postgresql://owner:owner@localhost:5436/csv2sql
READER_DATABASE_URL=postgresql://csv2sql_reader:reader-dev-password@localhost:5436/csv2sql
MODEL=openai:gpt-5-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
